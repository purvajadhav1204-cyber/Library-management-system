<!DOCTYPE html>
<html>
<head>
    <title>Admin Panel</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="d-flex">

    <!-- Sidebar -->
    <div class="sidebar">
        <h4>Library</h4>
        <hr>
        <a href="/user" class="btn btn-light w-100 mb-2">User View</a>
        <a href="/logout" class="btn btn-danger w-100">Logout</a>
    </div>

    <!-- Main Content -->
    <div class="content">

        <h2 class="mb-3">Admin Panel</h2>

        <a href="/add" class="btn btn-primary mb-3">Add New Book</a>

        <p><b>Total Books:</b> <%= books.length %></p>

        <table class="table table-striped">
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Quantity</th>
                <th>Actions</th>
            </tr>

            <% books.forEach(book => { %>
            <tr>
                <td><%= book.title %></td>
                <td><%= book.author %></td>
                <td><%= book.quantity %></td>
                <td>
                    <form action="/issue/<%= book._id %>" method="post" style="display:inline;">
                        <button class="btn btn-warning btn-sm">Issue</button>
                    </form>

                    <form action="/delete/<%= book._id %>" method="post" style="display:inline;">
                        <button class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
            <% }) %>
        </table>

    </div>
</div>

</body>
</html>
