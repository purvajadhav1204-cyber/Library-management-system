<!DOCTYPE html>
<html>
<head>
    <title>User Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #eef6ff; /* light blue */
        }
        .book-card img {
            height: 200px;
            object-fit: cover;
        }
    </style>
</head>
<body>
<div style="margin-bottom:20px;">
    <a href="/admin" class="btn btn-warning">Admin Panel</a>
    <a href="/logout" class="btn btn-danger">Logout</a>
</div>

<div class="container mt-4">

    <h2 class="text-center mb-4">Available Books</h2>

    <div class="row">

        <% books.forEach(book => { %>

        <div class="col-md-4 mb-4">
            <div class="card book-card shadow">

                <div class="card-body">
                    <img src="<%= book.image %>" class="card-img-top" alt="Book Image">

                    <p class="card-text mt-2">
                        <b>Title:</b> <%= book.title %><br>
                        <b>Author:</b> <%= book.author %><br>
                        <b>Price:</b> ₹ <%= book.price %><br>
                        <b>Available:</b> <%= book.quantity %>
                    </p>

                    <form action="/payment/<%= book._id %>" method="get">
                        <button class="btn btn-primary w-100">
                            Buy Book
                        </button>
                    </form>

                </div>

            </div>
        </div>

        <% }) %>

    </div>

</div>

</body>
</html>